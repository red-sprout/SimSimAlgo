{
  "name": "simsimalgo-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:atcoder-session": "npm run build && node dist/src/cli/check-atcoder-session.js",
    "sync:atcoder": "npm run build && node dist/src/cli/sync-atcoder.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
